# Copy to .env.local for local development. Never commit real values.

# --- Chatbot (Anthropic Claude API) ---
# console.anthropic.com → API Keys. Set a monthly spending limit! See DEPLOY.md.
ANTHROPIC_API_KEY=

# --- Callback form email (Resend) ---
# resend.com → API Keys (free tier is enough)
RESEND_API_KEY=
# Where callback-request notifications are delivered
CALLBACK_TO_EMAIL=
# Optional: verified sender, e.g. "mmoving.de <website@mmoving.de>".
# Defaults to Resend's onboarding sender if unset.
CALLBACK_FROM_EMAIL=

# --- Chat logging (Neon Postgres via Vercel Marketplace) ---
DATABASE_URL=

# --- Admin area (/admin/chats, HTTP Basic Auth) ---
ADMIN_USER=
ADMIN_PASSWORD=

# --- Site URL (used for canonical URLs, sitemap, hreflang) ---
NEXT_PUBLIC_SITE_URL=https://mmoving.de
